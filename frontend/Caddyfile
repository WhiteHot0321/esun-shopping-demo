# DOMAIN defaults to localhost for local docker-compose.prod.yml acceptance (Caddy then
# uses its internal, self-signed CA instead of trying real ACME/Let's Encrypt). Set the
# DOMAIN environment variable to a real public hostname (e.g. whitehot0321.duckdns.org)
# for an actual deployment, and Caddy automatically requests a real certificate instead.
{$DOMAIN:localhost} {
	encode gzip

	# Security headers (docs/tasks/064). The frontend loads nothing from other origins; the only cross-origin action is the
	# form POST to ECPay's cashier page, hence form-action. HSTS is off (max-age=0) until the final HTTPS domain is stable:
	# set HSTS_MAX_AGE (e.g. 31536000) only then, because browsers cache it and it cannot be undone from the server side.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://payment.ecpay.com.tw https://payment-stage.ecpay.com.tw"
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:0}"
		-Server
	}

	# Full path (including the /api or /uploads/products prefix) is forwarded as-is —
	# the backend itself serves both under those prefixes on its main port.
	handle /api/* {
		reverse_proxy backend:8080
	}

	handle /uploads/products/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
