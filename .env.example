# Copy this file to .env and adjust values for your local setup.
# .env is git-ignored — never commit real secrets.

# MySQL / docker-compose
DB_NAME=esun_shop
DB_PASSWORD=123456
DB_PORT=3306

# Spring Boot backend (must match the MySQL values above when running outside Docker)
DB_HOST=localhost
DB_USERNAME=root
SERVER_PORT=8080

# Product AI support (RAG) — Ollama provider
# If you have Ollama installed natively on Windows (ollama.exe running as a service),
# it already binds 127.0.0.1:11434 and the JVM will silently connect to THAT instead
# of this docker-compose container when both use 11434. Remap OLLAMA_PORT (e.g. 11435)
# and update OLLAMA_BASE_URL to match if you hit "model not found" errors from a model
# you already pulled.
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=4
# ANTHROPIC_API_KEY=          # only needed when LLM_PROVIDER=claude
