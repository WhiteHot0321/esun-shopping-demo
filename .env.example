# Copy this file to .env and adjust values for your local setup.
# .env is git-ignored — never commit real secrets.

# MySQL / docker-compose
DB_NAME=esun_shop
DB_PASSWORD=123456
DB_PORT=3306

# Spring Boot backend (must match the MySQL values above when running outside Docker)
DB_HOST=localhost
DB_USERNAME=root
SERVER_PORT=8080

# Product AI support (RAG) — Ollama provider
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30
RAG_TOP_K=4
# ANTHROPIC_API_KEY=          # only needed when LLM_PROVIDER=claude

# ECPay (綠界) payment gateway — Stage/sandbox credentials only, never production values here.
# Get the current Stage MerchantID/HashKey/HashIV from https://developers.ecpay.com.tw
# (verify on the official site — different community sources disagree, see docs/project-state.md).
# ECPAY_MERCHANT_ID=
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# ECPAY_PAYMENT_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# ECPAY_CALLBACK_URL is ECPay's server-to-server ReturnURL notify — it must be a URL ECPay's
# servers can reach over the public internet, so a bare localhost value will never be called.
# Use a tunnel (e.g. ngrok) pointed at POST /api/payments/ecpay/callback when testing locally.
# ECPAY_CALLBACK_URL=
# ECPAY_RETURN_URL is the browser's own post-payment redirect (ClientBackURL) — localhost is fine here.
# ECPAY_RETURN_URL=http://localhost:5173/
