# Copy this file to .env.prod and fill in real values. .env.prod is git-ignored — never
# commit it, never paste real values into a commit message, Notion, or chat.
# See docs/tasks/057-phase33-18-b2-external-resources-checklist.md for where each value
# should come from and where it eventually needs to live (GitHub Environment secret vs
# VM-local .env.prod).

# --- Database ---
DB_NAME=                # e.g. esun_shop
DB_PASSWORD=             # MySQL ROOT password; used only by MySQL and the one-shot `migrate` service (DDL). Not given to the backend.
APP_DB_PASSWORD=         # password of the data-only `esun_app` user the backend runs as; no quotes or backslashes

# --- Redis (stock cache) ---
BACKUP_DB_PASSWORD=      # optional: read-only dump user `esun_backup` for scripts/mysql-backup.sh (root is used when empty)
REDIS_PASSWORD=          # required — the prod compose always runs Redis with a password

# --- Auth ---
JWT_SECRET=              # >=32 bytes, must not start with "dev-only"

# --- CORS ---
CORS_ALLOWED_ORIGINS=    # e.g. https://whitehot0321.duckdns.org (plain origin, no path/wildcard)

# --- Payment (leave PAYMENT_PROVIDER=none for B2 local acceptance) ---
PAYMENT_PROVIDER=none    # none | ecpay (never sandbox in prod)
PAYMENT_CALLBACK_SECRET= # required only when PAYMENT_PROVIDER=ecpay
# ECPAY_MERCHANT_ID=     # required only when PAYMENT_PROVIDER=ecpay
# ECPAY_HASH_KEY=
# ECPAY_HASH_IV=
# ECPAY_PAYMENT_URL=
# ECPAY_CALLBACK_URL=
# ECPAY_RETURN_URL=

# --- AI support (Ollama, self-hosted per the B2 decision) ---
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Domain / TLS (Caddy) ---
DOMAIN=localhost         # real VM: whitehot0321.duckdns.org (DuckDNS, already registered)
                         # tunnel mode (docker-compose.tunnel.yml): http://:80 — see docs/tasks/060

# --- Image tags (B3 real deployment only; omit both to build locally instead) ---
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend:<commit-sha>
# FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/frontend:<commit-sha>

# --- Monitoring overlay (docker-compose.monitoring.yml) ---
GRAFANA_ADMIN_PASSWORD=  # required by the monitoring overlay; UIs bind to 127.0.0.1 only
